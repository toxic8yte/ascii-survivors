<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup><SharedContent Include="../data/*.json" /></ItemGroup>
  <Target Name="SyncContent" BeforeTargets="BeforeBuild">
    <MakeDir Directories="Data" />
    <Copy SourceFiles="@(SharedContent)" DestinationFolder="Data" SkipUnchangedFiles="true" />
  </Target>
</Project>
