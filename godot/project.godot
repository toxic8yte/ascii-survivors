; Native C# desktop port. Shared content comes from ../data during the build.
config_version=5

[application]
config/name="ASCII Survivors"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="ASCII Survivors"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=900
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="AsciiSurvivors"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.035, 1)

[physics]
common/physics_ticks_per_second=60
